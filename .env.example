# Optional: increases the OpenAlex API request allowance.
# This value is used on the server only.
OPENALEX_API_KEY=

# Supabase project URL and public publishable key (never a service-role key).
# Account routes, Google provider and email redirect setup: docs/AUTH_SETUP.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hosted AI uses Supabase Edge Function secrets, not provider keys on this host.
# Deploy supabase/functions/atlas-ai/index.ts; see docs/EDGE_AI_SETUP.md.
# MISTRAL_API_KEY, GEMINI_API_KEY and optional GROQ_API_KEY belong in Supabase Edge Function Secrets.
ATLAS_AI_EDGE_FUNCTION=atlas-ai

# Optional direct-provider mode for local/self-hosted development only:
# ATLAS_AI_BACKEND=direct
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Required for quizzes: one stable private secret (32+ characters) on the app host.
# Generate once with npm run setup:quiz-secret, then configure the same value on
# every instance/deployment. Keep it private and retain it for saved quizzes.
QUIZ_SIGNING_SECRET=



