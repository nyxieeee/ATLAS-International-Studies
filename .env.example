# Optional: increases the OpenAlex API request allowance.
# This value is used on the server only.
OPENALEX_API_KEY=

# Supabase project URL and public publishable key (never a service-role key).
# Account routes, Google provider and email redirect setup: docs/AUTH_SETUP.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Text, quizzes, chat and evidence review: Groq qwen/qwen3.8-27b.
# Grounded browser search: Groq openai/gpt-oss-120b (same server key).
GROQ_API_KEY=
# Image transcription: Mistral ministral-8b-latest. Keep both keys server-side.
MISTRAL_API_KEY=


# Optional: a stable random secret (32+ characters) lets saved quizzes be graded
# after server restarts and across server instances. Never expose this publicly.
QUIZ_SIGNING_SECRET=



